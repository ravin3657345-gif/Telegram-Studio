{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Telegram Studio",
  "version": "1.8.6",
  "identifier": "com.telegram-studio.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Telegram Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://asset.localhost https://*.basemaps.cartocdn.com; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://asset.localhost; media-src 'self' blob: data: https://asset.localhost; frame-ancestors 'none'; base-uri 'self';",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Artem Kurdov",
    "copyright": "© 2025 Artem Kurdov",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"]
      }
    }
  }
}
