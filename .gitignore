node_modules/
dist/
dist-ssr/
*.local
.build/

# Tauri
src-tauri/target/
src-tauri/gen/

# Android release signing key — never commit, needed for every future update
src-tauri/android-release.jks
src-tauri/android-release.properties

# Compiled dev tool (source: src-tauri/tools/keygen/src/main.rs)
/keygen.exe

# for-testers/ — built installers, test keys, archives and instructions for
# manual distribution to testers. Not part of the app itself.
for-testers/

# Android debug APK — huge, rebuilt on demand
for-testers-android/*.apk

# Old compiled installer artifacts — real releases go to D:\Релиз, not the repo
dist-release/

# Claude Code local settings/lock files — machine-specific
.claude/

# Credentials for scripts/setup-update-channel.ps1 and scripts/publish-update.ps1
# (Supabase service key / access token) — machine-local, same idea as
# sales-bot/token.txt. One KEY=VALUE per line.
scripts/.secrets.env

# Sales bot — a separate commercial tool (bot, control panel, Supabase
# functions) with real business/personal data (pricing, seller's Telegram
# id, tokens) baked into its config and screenshots. Not part of the app.
sales-bot/

# Local scratch and research dumps — never commit. .freebuff holds the live
# dev database, logs and the relay key; OSINT is a 176 MB third-party
# spiderfoot checkout with nothing app-specific in it.
.freebuff/
OSINT/

# OS
.DS_Store
Thumbs.db

