src-tauri/android-release.properties

# Compiled dev tool (source: src-tauri/tools/keygen/src/main.rs)
/keygen.exe

# for-testers/ — built installers, test keys and archives for manual
# distribution to testers. Real releases go to D:\Релиз, not the repo.
for-testers/*.msi
for-testers/*.rar
for-testers/*.zip
for-testers/keygen.exe
for-testers/KEY.txt

# Android debug APK — huge, rebuilt on demand
for-testers-android/*.apk

# Claude Code local settings/lock files — machine-specific
.claude/

# Sales bot — token.txt holds a real bot secret, the launcher exe is a
